{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlowSight Agent",
  "version": "5.0.13",
  "identifier": "ai.flowsight.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --filter @flowsight/agent vite",
    "beforeBuildCommand": "pnpm --filter @flowsight/agent exec node ../../scripts/fetch-models.mjs && pnpm --filter @flowsight/agent vite build"
  },
  "app": {
    "windows": [
      {
        "title": "FlowSight — Understand your own Workflows",
        "width": 370,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 340,
        "minHeight": 400,
        "decorations": true,
        "dragDropEnabled": false,
        "backgroundColor": "#FBFCFB"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-tools",
          "gstreamer1.0-pipewire",
          "libpipewire-0.3-0"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../local_llm/Qwen3VL-2B-Instruct-Q4_K_M.gguf": "local_llm/Qwen3VL-2B-Instruct-Q4_K_M.gguf",
      "../../../local_llm/mmproj-Qwen3VL-2B-Instruct-Q8_0.gguf": "local_llm/mmproj-Qwen3VL-2B-Instruct-Q8_0.gguf",
      "../../../local_llm/APACHE-2.0.md": "local_llm/APACHE-2.0.md",
      "../../../local_llm/MODEL_NOTICE.md": "local_llm/MODEL_NOTICE.md",
      "../browser-extension/manifest.json": "browser-extension/manifest.json",
      "../browser-extension/worker.js": "browser-extension/worker.js",
      "../browser-extension/options.html": "browser-extension/options.html",
      "../browser-extension/options.js": "browser-extension/options.js",
      "../browser-extension/blocked.html": "browser-extension/blocked.html",
      "../browser-extension/blocked.js": "browser-extension/blocked.js",
      "../browser-extension/focus.css": "browser-extension/focus.css",
      "../browser-extension/icon16.png": "browser-extension/icon16.png",
      "../browser-extension/icon48.png": "browser-extension/icon48.png",
      "../browser-extension/icon128.png": "browser-extension/icon128.png"
    }
  }
}
